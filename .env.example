# Seridian lander — contact form
# Copy to .env.local and fill in. The form is a server action
# (src/app/actions/contact.ts) that POSTs a signed payload to the contact
# webhook hosted on the Seridian portal (app.seridian.dev).

# Full URL of the webhook receiver on the portal deploy.
CONTACT_WEBHOOK_URL=https://app.seridian.dev/api/webhooks/seridian-contact

# Shared secret — MUST be the exact same value as CONTACT_WEBHOOK_SECRET on the
# portal deploy. Used for the bearer token and the HMAC body signature.
# Never commit the real value; set it as a Netlify environment variable
# (production + deploy previews) and in .env.local for local dev.
CONTACT_WEBHOOK_SECRET=

# Convex — https://convex.dev
# Run `bun x convex dev` to auto-generate .env.local with these values.
NEXT_PUBLIC_CONVEX_URL=your_convex_deployment_url
CONVEX_DEPLOYMENT=your_convex_deployment_name
