# Seridian lander — contact form
# Copy to .env.local and fill in. The form is a server action
# (src/app/actions/contact.ts) that POSTs JSON to the portal's Forms
# backend — a public Formspree-style endpoint (no Authorization/signature
# headers required; lander-side honeypot + rate limit remain the throttle).

# Public Forms endpoint for contact submissions.
CONTACT_WEBHOOK_URL=https://fleet-fish-566.convex.site/forms/seridian-contact

# Legacy/unused — deprecated. The old signed Next.js receiver and its
# shared-secret HMAC scheme are retired. Leave blank; do not set a value.
CONTACT_WEBHOOK_SECRET=

# Convex — https://convex.dev
# Run `bun x convex dev` to auto-generate .env.local with these values.
NEXT_PUBLIC_CONVEX_URL=your_convex_deployment_url
CONVEX_DEPLOYMENT=your_convex_deployment_name
