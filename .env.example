# Seridian contact form -> GitHub Projects
# Copy to .env.local and fill in. GET endpoint: /api/contact

# GitHub Personal Access Token (fine-grained recommended).
# See README "Contact form (GitHub Projects)" for setup steps.
GITHUB_TOKEN=ghp_your_token_here

# Repository where contact issues are created (owner/repo).
GITHUB_REPO=therodfather/seridian

# GitHub Projects v2 board — use project number (from URL) or GraphQL node ID.
# URL https://github.com/users/therodfather/projects/1 → number is 1
GITHUB_PROJECT_NUMBER=1
# GITHUB_PROJECT_ID=PVT_kwDO...  # optional alternative to GITHUB_PROJECT_NUMBER

# Status column for new contact issues (exact label from the project board).
# Without this, items default to the first Status option (usually "Todo").
GITHUB_PROJECT_STATUS=YourColumnName

# Optional live checkout for the $999 Cloud Health Check (Stripe Payment Link,
# PayPal, or Wise). If unset, the packages CTA falls back to mailto:hello@seridian.dev.
# NEXT_PUBLIC_HEALTH_CHECK_PAY_URL=https://buy.stripe.com/your_live_link

# Optional 15-min kickoff calendar (Calendly, SavvyCal, etc.).
# If unset, "Book a 15-min kickoff" scrolls to /#contact.
# NEXT_PUBLIC_KICKOFF_URL=https://calendly.com/your-link

# Convex — https://convex.dev
# Run `bun x convex dev` to auto-generate .env.local with these values.
NEXT_PUBLIC_CONVEX_URL=your_convex_deployment_url
CONVEX_DEPLOYMENT=your_convex_deployment_name

# --- Telnyx IVR (Call Control) — set on the Convex deployment, not Netlify ---
# Preferred: Settings → Integrations → Connect Telnyx (stores keys in the vault).
# Fallback / ops: `bunx convex env set KEY value` on your *dev* deployment only.
# Do not put real secrets in this file.
#
# TELNYX_API_KEY          — Mission Control → Auth → API Keys (Call Control)
# TELNYX_PUBLIC_KEY       — Account public key (Ed25519) for webhook signatures
# TELNYX_CONNECTION_ID    — optional; usually created per-flow by assignNumber
# CONVEX_SITE_URL         — auto on Convex; used as https://<deployment>.convex.site
#                           Webhook path registered: {CONVEX_SITE_URL}/telnyx/webhook

# Linear — https://linear.app
# Personal API key for syncing Linear data (teams, projects, labels, users, issues).
# Prefer Settings → Integrations (vault). Env fallback is deprecated for new setups.
LINEAR_API_KEY=lin_api_your_key_here

# --- Workflows automation (Convex HTTP + schedules) ---
# No Netlify secrets required. Webhook URLs use the Convex site host:
#   POST {CONVEX_SITE_URL}/workflows/webhook/{token}
# CONVEX_SITE_URL is set automatically on Convex deployments.
# Schedule triggers are polled by convex/crons.ts (1-minute interval).
# Linear action steps reuse LINEAR_API_KEY + integrationConfigs.teamId (server-side only).

# --- Forms (Formspree/Jotform-style, Business → Forms) ---
# Hosted page: /f/{slug}
# API (CORS enabled): POST {CONVEX_SITE_URL}/forms/{slug}
# Optional NEXT_PUBLIC_CONVEX_SITE_URL for showing the API URL in the builder UI.
# NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
